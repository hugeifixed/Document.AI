#!/usr/bin/env sh
set -eu

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# Keep each stack's tooling independent. A frontend-only commit needs Node;
# a backend-only commit needs Python/uv; a cross-stack commit runs both.
if ! git diff --cached --quiet -- frontend/; then
  npm --prefix frontend run check:pre-commit
fi

if ! git diff --cached --quiet -- backend/ cli/ .pre-commit-config.yaml; then
  if ! git diff --cached --quiet -- backend/ .pre-commit-config.yaml; then
    # Backend and shared hook-config changes use backend's provisioned tools.
    # CLI hooks still run in the CLI's own environment from .pre-commit-config.yaml.
    uv run --project backend --isolated --extra dev pre-commit run
  else
    # A CLI-only change needs the CLI toolchain, not the backend environment.
    uv run --directory cli --project . --isolated --group dev pre-commit run
  fi
fi
