# Local development. Copy to backend/.env; manage.py selects
# config.settings.local by default.

# --- Django and database
DOCAI_ENVIRONMENT=local
DOCAI_BUILD_SHA=
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DATABASE_URL defaults to backend/data/docai.sqlite3 (absolute path) when unset
# DATABASE_URL=oracle://user:pass@host:1521/service

# --- Frontend and browser access
# The Vite development server makes credentialed API requests to Django.
DOCAI_FRONTEND_URL=http://localhost:5173/
DOCAI_CORS_ORIGINS=http://localhost:5173
DOCAI_CSRF_TRUSTED=http://localhost:5173

# --- Platform adapters (local defaults; no Azure calls)
# Layout: azure_di | pypdf | fixture. LLM: azure_openai | mock.
DOCAI_LAYOUT_ADAPTER=pypdf
DOCAI_LLM_ADAPTER=mock

# --- Azure identity (Azure CLI, service principal, or managed identity)
# Optional service principal: uncomment and supply ALL THREE through the secret store.
# The Azure SDK reads these directly; no Django setting or code change is needed.
# Leave unset (not empty) when using Azure CLI or managed identity authentication.
# AZURE_TENANT_ID=your-directory-tenant-id
# AZURE_CLIENT_ID=your-application-client-id
# AZURE_CLIENT_SECRET=your-client-secret-value
# The same identity needs access to both DI and the Azure OpenAI resource.

# --- Azure Document Intelligence
AZURE_DI_ENDPOINT=
AZURE_DI_API_VERSION=2024-11-30
# Optional temporary DI testing with a resource key (config.settings.local only).
# Blank uses DefaultAzureCredential. Never commit a populated key.
AZURE_DI_API_KEY=

# --- Azure OpenAI
# Use the resource root, without /openai/v1 or /chat/completions.
# Deployment must match Azure; an explicit workflow model.deployment overrides it.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=gpt-5.2
# Optional temporary LLM testing (config.settings.local only); separate from the DI key.
AZURE_OPENAI_API_KEY=

# --- Azure request timeouts and retries
AZURE_TIMEOUT_S=60
AZURE_MAX_RETRIES=3

# --- Optional scan enhancement (install .[image-normalization] and opt in per workflow)
DOCAI_IMAGE_NORMALIZATION_ENABLED=false

# --- Processing
# sync | thread | celery. The thread runner needs no separate worker.
DOCAI_TASK_RUNNER=thread
DOCAI_MAX_WORKERS=4

# --- Celery (optional; only used with DOCAI_TASK_RUNNER=celery)
# Local settings default to filesystem:// when this is blank. For Redis, use
# redis://localhost:6379/0. The application does not require a result backend.
CELERY_BROKER_URL=
# Windows defaults to %LOCALAPPDATA%\DocAI\celery; macOS/Linux use ./data/celery.
# Override with a short absolute path if your Windows user profile is deeply nested.
# CELERY_FILESYSTEM_DIR=C:\docai-celery
# Defaults: solo on macOS, threads on Windows, prefork on Linux.
# macOS native libraries can crash after fork(); do not use prefork there.
# CELERY_WORKER_POOL=solo
# CELERY_WORKER_CONCURRENCY=1
CELERY_TASK_TIME_LIMIT=1800
CELERY_TASK_SOFT_TIME_LIMIT=1500
CELERY_TASK_MAX_RETRIES=3
CELERY_TASK_MAX_DELIVERIES=5
CELERY_TASK_RETRY_BACKOFF_SECONDS=15
CELERY_TASK_RETRY_BACKOFF_MAX_SECONDS=600
# CELERY_BROKER_VISIBILITY_TIMEOUT=3600

# --- Upload and archive limits
DOCAI_MAX_UPLOAD_MB=100
DOCAI_MAX_PAGES=500
DOCAI_MAX_SHEETS=50
DOCAI_MAX_BATCH_FILES=500
DOCAI_MAX_ARCHIVE_MEMBERS=2000
DOCAI_MAX_ARCHIVE_MEMBER_MB=64
DOCAI_MAX_ARCHIVE_EXPANDED_MB=256
DOCAI_MAX_ARCHIVE_COMPRESSION_RATIO=100

# --- Cache
DOCAI_CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
DOCAI_CACHE_LOCATION=docai-default
DOCAI_CACHE_TTL=300
DOCAI_CACHE_MAX_ENTRIES=2000

# --- API throttling
DOCAI_THROTTLE_USER=600/min
DOCAI_THROTTLE_ANON=60/min

# --- Logging and diagnostics
DOCAI_LOG_JSON=false
DOCAI_LOG_LEVEL=INFO
DOCAI_SLOW_REQUEST_MS=1000

# Temporary evidence diagnostics, local DEBUG only. Restart Django and any Celery workers after changing.
# Contains document text and model values; see CELERY.md. Off by default.
DOCAI_LLM_DEBUG_CAPTURE=false

# --- Profiling
# Opt-in Django request/SQL profiler at /admin/profiler/ (superusers only).
DJANGO_SILKY_ENABLED=false
DJANGO_SILKY_MAX_RECORDED_REQUESTS=2000
