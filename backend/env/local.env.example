# Local development. Copy to backend/.env; manage.py selects
# config.settings.local by default.

# --- Django
DOCAI_ENVIRONMENT=local
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DATABASE_URL defaults to backend/data/docai.sqlite3 (absolute path) when unset
# DATABASE_URL=oracle://user:pass@host:1521/service

# --- Platform adapters (keyless local defaults)
DOCAI_LAYOUT_ADAPTER=pypdf          # azure_di | pypdf | fixture
DOCAI_LLM_ADAPTER=mock              # azure_openai | mock
DOCAI_TASK_RUNNER=thread            # sync | thread | celery
DOCAI_MAX_WORKERS=4

# --- Optional scan enhancement (install .[image-normalization] and opt in per workflow)
DOCAI_IMAGE_NORMALIZATION_ENABLED=false

# --- Azure (identity-based; run `az login` locally, managed identity when deployed)
AZURE_DI_ENDPOINT=
AZURE_DI_API_VERSION=2024-11-30
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_TIMEOUT_S=60
AZURE_MAX_RETRIES=3

# --- Limits
DOCAI_MAX_UPLOAD_MB=100
DOCAI_MAX_PAGES=500
DOCAI_MAX_SHEETS=50
DOCAI_MAX_BATCH_FILES=500
DOCAI_MAX_ARCHIVE_MEMBERS=2000
DOCAI_MAX_ARCHIVE_MEMBER_MB=64
DOCAI_MAX_ARCHIVE_EXPANDED_MB=256
DOCAI_MAX_ARCHIVE_COMPRESSION_RATIO=100

# --- Cache / logging
DOCAI_CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
DOCAI_CACHE_LOCATION=docai-default
DOCAI_CACHE_TTL=300
DOCAI_CACHE_MAX_ENTRIES=2000
DOCAI_THROTTLE_USER=600/min
DOCAI_THROTTLE_ANON=60/min
DOCAI_LOG_JSON=false
DOCAI_LOG_LEVEL=INFO
DOCAI_SLOW_REQUEST_MS=1000
# Opt-in Django request/SQL profiler at /admin/profiler/ (superusers only).
DJANGO_SILKY_ENABLED=false
DJANGO_SILKY_MAX_RECORDED_REQUESTS=2000

# The Vite development server makes credentialed API requests to Django.
DOCAI_FRONTEND_URL=http://localhost:5173/
DOCAI_CORS_ORIGINS=http://localhost:5173
DOCAI_CSRF_TRUSTED=http://localhost:5173

# --- Celery (optional; only used with DOCAI_TASK_RUNNER=celery)
# Local settings default to filesystem:// when this is blank. For Redis, use
# redis://localhost:6379/0. The application does not require a result backend.
CELERY_BROKER_URL=
# Windows defaults to %LOCALAPPDATA%\DocAI\celery; macOS/Linux use ./data/celery.
# Override with a short absolute path if your Windows user profile is deeply nested.
# CELERY_FILESYSTEM_DIR=C:\docai-celery
# Defaults: threads on Windows, prefork on macOS/Linux. Windows may also use solo.
# CELERY_WORKER_POOL=threads
# CELERY_WORKER_CONCURRENCY=1
CELERY_TASK_TIME_LIMIT=1800
CELERY_TASK_SOFT_TIME_LIMIT=1500
CELERY_TASK_MAX_RETRIES=3
CELERY_TASK_MAX_DELIVERIES=5
CELERY_TASK_RETRY_BACKOFF_SECONDS=15
CELERY_TASK_RETRY_BACKOFF_MAX_SECONDS=600
# CELERY_BROKER_VISIBILITY_TIMEOUT=3600
