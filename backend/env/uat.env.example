# UAT deployment template (Linux).
# Supply these values through the deployment platform or secret store.
# Set DJANGO_SETTINGS_MODULE=config.settings.production before Django starts;
# placing DJANGO_SETTINGS_MODULE only inside .env is too late for manage.py startup.

# --- Django and database
DOCAI_ENVIRONMENT=uat
DOCAI_BUILD_SHA=replace-with-deployment-commit
DJANGO_SECRET_KEY=replace-with-a-unique-secret-from-the-secret-store
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=docai-uat.example.invalid
DATABASE_URL=oracle://docai_app:replace-me@docai-uat-db.example.invalid:1521/service

# --- Transport security
# Keep false unless the trusted reverse proxy strips client-supplied
# X-Forwarded-Proto before setting its own value.
DJANGO_TRUST_X_FORWARDED_PROTO=false
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
DOCAI_ENABLE_BASIC_AUTH=false

# --- Frontend and browser access
# The frontend is normally served from the same origin. Keep these explicit if
# the browser frontend is hosted separately; an empty list disables CORS.
DOCAI_FRONTEND_URL=/
DOCAI_CORS_ORIGINS=https://docai-uat.example.invalid
DOCAI_CSRF_TRUSTED=https://docai-uat.example.invalid

# --- Platform adapters
DOCAI_LAYOUT_ADAPTER=azure_di
DOCAI_LLM_ADAPTER=azure_openai

# --- Azure identity (service principal or managed identity; no resource API keys)
# Optional service principal: uncomment and supply ALL THREE through the secret store.
# The Azure SDK reads these directly; no Django setting or code change is needed.
# Leave unset (not empty) when using Azure CLI or managed identity authentication.
# AZURE_TENANT_ID=your-directory-tenant-id
# AZURE_CLIENT_ID=your-application-client-id
# AZURE_CLIENT_SECRET=your-client-secret-value
# The same identity needs access to both DI and the Azure OpenAI resource.

# --- Azure Document Intelligence
AZURE_DI_ENDPOINT=https://replace-uat-di.cognitiveservices.azure.com/
AZURE_DI_API_VERSION=2024-11-30

# --- Azure OpenAI
# Use the resource root, without /openai/v1 or /chat/completions.
# Deployment must match Azure; an explicit workflow model.deployment overrides it.
AZURE_OPENAI_ENDPOINT=https://replace-uat-foundry.cognitiveservices.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=replace-with-deployment-name

# --- Azure request timeouts and retries
AZURE_TIMEOUT_S=60
AZURE_MAX_RETRIES=3

# --- Optional scan enhancement (install .[image-normalization] and opt in per workflow)
DOCAI_IMAGE_NORMALIZATION_ENABLED=false

# --- Processing and storage
DOCAI_TASK_RUNNER=celery
DOCAI_MAX_WORKERS=4
DOCAI_DATA_DIR=/var/lib/docai/uat

# --- Celery (used with DOCAI_TASK_RUNNER=celery)
# This filesystem broker is only for the initial single-host deployment where
# Django and the worker share this persistent directory. Change the URL to a
# network broker before adding another host.
CELERY_BROKER_URL=filesystem://
CELERY_FILESYSTEM_DIR=/var/lib/docai/uat/celery
CELERY_RESULT_BACKEND=
CELERY_WORKER_POOL=prefork
CELERY_WORKER_CONCURRENCY=4
CELERY_TASK_TIME_LIMIT=1800
CELERY_TASK_SOFT_TIME_LIMIT=1500
CELERY_TASK_MAX_RETRIES=3
CELERY_TASK_MAX_DELIVERIES=5
CELERY_TASK_RETRY_BACKOFF_SECONDS=15
CELERY_TASK_RETRY_BACKOFF_MAX_SECONDS=600
# Redis alternative: redis://redis-host:6379/0

# --- Upload limits and retention
DOCAI_MAX_UPLOAD_MB=100
DOCAI_MAX_PAGES=500
DOCAI_MAX_SHEETS=50
DOCAI_MAX_BATCH_FILES=500
DOCAI_RAW_RESPONSE_RETENTION_DAYS=30
DOCAI_IDEMPOTENCY_RETENTION_DAYS=30

# --- Cache
# LocMem works without Redis but is isolated per web process.
DOCAI_CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
DOCAI_CACHE_LOCATION=docai-uat
DOCAI_CACHE_TTL=300
DOCAI_CACHE_MAX_ENTRIES=2000

# --- API throttling
DOCAI_THROTTLE_USER=600/min
DOCAI_THROTTLE_ANON=60/min

# --- Logging and diagnostics
DOCAI_LOG_JSON=true
DOCAI_LOG_LEVEL=INFO
DOCAI_SLOW_REQUEST_MS=1000

# --- Profiling
# Request/SQL profiling at /admin/profiler/ (superusers only); opt in when needed.
DJANGO_SILKY_ENABLED=false
DJANGO_SILKY_MAX_RECORDED_REQUESTS=2000
