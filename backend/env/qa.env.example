# QA deployment template (Linux).
# Supply these values through the deployment platform or secret store.
# Set DJANGO_SETTINGS_MODULE=config.settings.production before Django starts;
# placing DJANGO_SETTINGS_MODULE only inside .env is too late for manage.py startup.

# --- Deployment identity and Django
DOCAI_ENVIRONMENT=qa
DJANGO_SECRET_KEY=replace-with-a-unique-secret-from-the-secret-store
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=docai-qa.example.invalid
DATABASE_URL=oracle://docai_app:replace-me@docai-qa-db.example.invalid:1521/service

# Keep false unless the trusted reverse proxy strips client-supplied
# X-Forwarded-Proto before setting its own value.
DJANGO_TRUST_X_FORWARDED_PROTO=false
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
DOCAI_ENABLE_BASIC_AUTH=false

# The frontend is normally served from the same origin. Keep these explicit if
# the browser frontend is hosted separately; an empty list disables CORS.
DOCAI_CORS_ORIGINS=https://docai-qa.example.invalid
DOCAI_CSRF_TRUSTED=https://docai-qa.example.invalid

# --- Azure services (DefaultAzureCredential / managed identity; no API keys)
DOCAI_LAYOUT_ADAPTER=azure_di
DOCAI_LLM_ADAPTER=azure_openai
AZURE_DI_ENDPOINT=https://replace-qa-di.cognitiveservices.azure.com/
AZURE_DI_API_VERSION=2024-11-30
AZURE_OPENAI_ENDPOINT=https://replace-qa-foundry.cognitiveservices.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=replace-with-deployment-name
AZURE_TIMEOUT_S=60
AZURE_MAX_RETRIES=3

# --- Processing and storage
DOCAI_TASK_RUNNER=celery
DOCAI_MAX_WORKERS=4
DOCAI_DATA_DIR=/var/lib/docai/qa
DOCAI_MAX_UPLOAD_MB=100
DOCAI_MAX_PAGES=500
DOCAI_MAX_SHEETS=50
DOCAI_MAX_BATCH_FILES=500
DOCAI_RAW_RESPONSE_RETENTION_DAYS=30

# --- Cache, throttling, profiling, and logging
# LocMem works without Redis but is isolated per web process.
DOCAI_CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
DOCAI_CACHE_LOCATION=docai-qa
DOCAI_CACHE_TTL=300
DOCAI_CACHE_MAX_ENTRIES=2000
DOCAI_THROTTLE_USER=600/min
DOCAI_THROTTLE_ANON=60/min
DJANGO_SILKY_ENABLED=false
DJANGO_SILKY_MAX_RECORDED_REQUESTS=2000
DOCAI_LOG_JSON=true
DOCAI_LOG_LEVEL=INFO
DOCAI_SLOW_REQUEST_MS=1000

# --- Celery
# This filesystem broker is only for the initial single-host deployment where
# Django and the worker share this persistent directory. Change the URL to a
# network broker before adding another host.
CELERY_BROKER_URL=filesystem://
CELERY_FILESYSTEM_DIR=/var/lib/docai/qa/celery
CELERY_RESULT_BACKEND=
CELERY_WORKER_POOL=prefork
CELERY_WORKER_CONCURRENCY=4
CELERY_TASK_TIME_LIMIT=1800
CELERY_TASK_SOFT_TIME_LIMIT=1500
CELERY_TASK_MAX_RETRIES=3
CELERY_TASK_MAX_DELIVERIES=5
CELERY_TASK_RETRY_BACKOFF_SECONDS=15
CELERY_TASK_RETRY_BACKOFF_MAX_SECONDS=600
# Redis alternative: redis://redis-host:6379/0
